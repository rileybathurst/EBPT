  "scripts": {
    "dev": "astro dev",
    "start": "bun run astro check && stay-gold && blc http://emeraldbay.physio --exclude '*yelp*' && pa11y http://emeraldbay.physio && astro dev",
    "build": "bun run astro check && astro build",
    "preview": "astro preview",
    "blc": "blc http://emeraldbay.physio --exclude '*yelp*'",
    "typecheck": "bun run astro check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gold": "stay-gold"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@types/node": "^26.1.1",
    "astro": "7.2.10",
